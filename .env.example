# Copier en .env (jamais commité). Une configuration par environnement : développement, test, production.
IMMOZEN_ENV=development
# Project Settings > API dans Supabase
IMMOZEN_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé PUBLIQUE (anon / publishable). Le build refuse une clé service_role ou sb_secret_.
IMMOZEN_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
